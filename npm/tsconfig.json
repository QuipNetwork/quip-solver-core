{
  "compilerOptions": {
    "target": "ES2022",
    // node16 rather than commonjs/node10: TypeScript 7 removed the node10
    // resolver. package.json declares no "type", so node16 still emits CommonJS.
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "rootDir": "./src",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // verbatimModuleSyntax is omitted: this package emits CommonJS
    // (package.json has no "type":"module", and src/index.ts uses require()
    // so the .wasm binary resolves at runtime). TypeScript rejects ESM
    // import/export syntax under that flag when the emit is CJS.
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
