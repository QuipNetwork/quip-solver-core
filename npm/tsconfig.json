{
  "compilerOptions": {
    "target": "ES2022",
    // node16 rather than commonjs/node10: TypeScript 7 removed the node10
    // resolver. package.json declares no "type", so node16 still emits CommonJS.
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "rootDir": "./src",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
